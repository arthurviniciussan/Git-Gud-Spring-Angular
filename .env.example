# Copie para .env e preencha. O .env esta no .gitignore e nunca entra no
# repositorio.
#
#   cp .env.example .env

# ---------- Banco ----------
# Valores de desenvolvimento local. Em producao, troque os tres.
DATABASE_NAME=gitgud_db
DATABASE_USER=gitgud
DATABASE_PASSWORD=gitgud
DATABASE_ROOT_PASSWORD=root-de-desenvolvimento

# ---------- Admin: o unico usuario do blog ----------
GITGUD_ADMIN_EMAIL=voce@exemplo.com
GITGUD_ADMIN_NAME=Seu Nome

# A senha NUNCA e escrita aqui — so o hash BCrypt dela. Gere assim:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 12 admin 'SUA_SENHA_FORTE' | cut -d: -f2
# Sem esta variavel a aplicacao nao sobe.
GITGUD_ADMIN_PASSWORD_HASH=

# ---------- JWT ----------
# Minimo 32 caracteres (HS256 exige 256 bits). Gere assim:
#   openssl rand -base64 48
# Sem esta variavel a aplicacao nao sobe.
GITGUD_JWT_SECRET=

# ---------- Frontend ----------
# Origens autorizadas a chamar a API, separadas por virgula.
GITGUD_CORS_ORIGINS=http://localhost:4200
